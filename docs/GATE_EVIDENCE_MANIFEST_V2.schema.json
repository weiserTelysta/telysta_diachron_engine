{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telysta.example/schemas/gate-evidence-manifest-v2.schema.json",
  "title": "Telysta GateEvidenceManifest v2",
  "description": "A portable attestation for a committed subject revision. The attestation may be committed after the subject without becoming self-referential.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "gateId",
    "gateName",
    "decision",
    "decisionDate",
    "source",
    "claims",
    "evidence",
    "requirements",
    "blockers",
    "owner",
    "reviewers",
    "waivers",
    "expiresWhen",
    "nextDecision"
  ],
  "properties": {
    "$schema": {
      "const": "GATE_EVIDENCE_MANIFEST_V2.schema.json"
    },
    "schemaVersion": {
      "const": "telysta-gate-evidence-manifest.v2"
    },
    "gateId": {
      "const": "G0A"
    },
    "gateName": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "blocked",
        "passed"
      ]
    },
    "decisionDate": {
      "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/isoDate"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "claims": {
      "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/claims"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/evidenceItem"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/requirement"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/blocker"
      }
    },
    "owner": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/identity"
        },
        {
          "$ref": "#/$defs/accountIdentity"
        }
      ]
    },
    "reviewers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/identity"
          },
          {
            "$ref": "#/$defs/reviewerAttestation"
          }
        ]
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/waiver"
      }
    },
    "expiresWhen": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nextDecision": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "passed"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "required": [
              "verificationRuns"
            ],
            "properties": {
              "worktreeDirty": {
                "const": false
              },
              "verificationRuns": {
                "minItems": 1
              }
            }
          },
          "blockers": {
            "maxItems": 0
          },
          "owner": {
            "$ref": "#/$defs/accountIdentity"
          },
          "reviewers": {
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/reviewerAttestation"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "accountIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "stableAccountId",
        "login",
        "displayName",
        "role"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "stableAccountId": {
          "type": "string",
          "minLength": 1
        },
        "login": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "stableAccountId",
        "login",
        "displayName",
        "roles",
        "reviewedSubjectCommit",
        "reviewedSubjectTree",
        "reviewUrl",
        "reviewId",
        "decision",
        "reviewedAt",
        "conflictOfInterest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "stableAccountId": {
          "type": "string",
          "minLength": 1
        },
        "login": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "architecture",
              "migration",
              "storage",
              "determinism",
              "product"
            ]
          }
        },
        "reviewedSubjectCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewedSubjectTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewUrl": {
          "type": "string",
          "format": "uri"
        },
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "const": "accepted"
        },
        "reviewedAt": {
          "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/utcDateTime"
        },
        "conflictOfInterest": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectCommit",
        "subjectTree",
        "worktreeDirty",
        "worktreeStatusEntryCount",
        "worktreeFingerprintSchema",
        "worktreeInventorySha256",
        "excludedGeneratedPaths",
        "environment"
      ],
      "properties": {
        "subjectCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "subjectTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktreeDirty": {
          "type": "boolean"
        },
        "worktreeStatusEntryCount": {
          "type": "integer",
          "minimum": 0
        },
        "worktreeFingerprintSchema": {
          "const": "telysta-git-worktree-fingerprint.v2"
        },
        "worktreeInventorySha256": {
          "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/sha256"
        },
        "excludedGeneratedPaths": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "verificationRuns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verificationRun"
          }
        }
      }
    },
    "verificationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "subjectCommit",
        "subjectTree",
        "startedAt",
        "finishedAt",
        "result",
        "protocols",
        "environment"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^gate-run:[0-9a-f]{32}$"
        },
        "subjectCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "subjectTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "startedAt": {
          "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/utcDateTime"
        },
        "finishedAt": {
          "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/utcDateTime"
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environment": {
          "$ref": "#/$defs/verificationEnvironment"
        }
      }
    },
    "verificationEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "pythonExecutable",
        "pythonVersion",
        "pythonInstalledDistributionsSha256",
        "pythonLockStatus",
        "pythonLockMismatches",
        "rustcVersion",
        "cargoVersion",
        "requiredRustVersion",
        "rustVersionMeetsWorkspace",
        "nodeVersion",
        "lockFileSha256"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "pythonExecutable": {
          "type": "string",
          "minLength": 1
        },
        "pythonVersion": {
          "type": "string",
          "minLength": 1
        },
        "pythonInstalledDistributionsSha256": {
          "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/sha256"
        },
        "pythonLockStatus": {
          "enum": [
            "match",
            "mismatch"
          ]
        },
        "pythonLockMismatches": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rustcVersion": {
          "type": "string",
          "minLength": 1
        },
        "cargoVersion": {
          "type": "string",
          "minLength": 1
        },
        "requiredRustVersion": {
          "const": "1.77.2"
        },
        "rustVersionMeetsWorkspace": {
          "type": "boolean"
        },
        "nodeVersion": {
          "type": "string",
          "minLength": 1
        },
        "lockFileSha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Cargo.lock",
            "poetry.lock"
          ],
          "properties": {
            "Cargo.lock": {
              "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/sha256"
            },
            "poetry.lock": {
              "$ref": "https://telysta.example/schemas/gate-evidence-manifest-v1.schema.json#/$defs/sha256"
            }
          }
        }
      }
    }
  }
}
