    "accountIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "stableAccountId",
        "login",
        "displayName",
        "role"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "stableAccountId": {
          "type": "string",
          "minLength": 1
        },
        "login": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "stableAccountId",
        "login",
        "displayName",
        "roles",
        "reviewedSubjectCommit",
        "reviewedSubjectTree",
        "reviewUrl",
        "reviewId",
        "decision",
        "reviewedAt",
        "conflictOfInterest"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "stableAccountId": {
          "type": "string",
          "minLength": 1
        },
        "login": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "architecture",
              "migration",
              "storage",
              "determinism",
              "product",
              "release"
            ]
          }
        },
        "reviewedSubjectCommit": {
          "$ref": "#/$defs/gitObjectId"
        },
        "reviewedSubjectTree": {
          "$ref": "#/$defs/gitObjectId"
        },
        "reviewUrl": {
          "type": "string",
          "format": "uri"
        },
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "const": "accepted"
        },
        "reviewedAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "conflictOfInterest": {
          "const": false
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availablePersonHours",
        "periodStart",
        "periodEnd"
      ],
      "properties": {
        "availablePersonHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "periodStart": {
          "$ref": "#/$defs/isoDate"
        },
        "periodEnd": {
          "$ref": "#/$defs/isoDate"
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "unit",
        "optimistic",
        "mostLikely",
        "pessimistic"
      ],
      "properties": {
        "method": {
          "const": "three-point"
        },
        "unit": {
          "const": "person-hours"
        },
        "optimistic": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mostLikely": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pessimistic": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "wip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "globalLimit",
        "slot"
      ],
      "properties": {
        "globalLimit": {
          "type": "integer",
          "minimum": 1
        },
        "slot": {
          "enum": [
            "WIP-GATE",
            "WIP-PRODUCT",
            "QUEUED-DOMAIN"
          ]
        }
      }
    },
    "timebox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startsAt",
        "endsAt"
      ],
      "properties": {
        "startsAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "endsAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocking",
            "high",
            "medium",
            "low"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "status",
        "requestedBy",
        "approvedBy",
        "reason",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "requirementId": {
          "$ref": "#/$defs/requirementId"
        },
        "status": {
          "$ref": "#/$defs/waiverStatus"
        },
        "requestedBy": {
          "$ref": "#/$defs/accountIdentity"
        },
        "approvedBy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/accountIdentity"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "$ref": "#/$defs/utcDateTime"
        },
        "expiresAt": {
          "$ref": "#/$defs/utcDateTime"
        }
      }
    }
  }
